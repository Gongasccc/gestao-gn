rules_version = '2';

// Regras do Firestore da Gestão G&N.
// Todos os dados vivem em /artifacts/{appId}/... (prefixo herdado da versão original).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /artifacts/{appId} {

      function household(hid) {
        return get(/databases/$(database)/documents/artifacts/$(appId)/households/$(hid)).data;
      }
      function isMember(hid) {
        return signedIn() && request.auth.uid in household(hid).members;
      }

      // ---------- Perfis (pesquisáveis por outros utilizadores autenticados) ----------
      match /public/data/profiles/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && request.resource.data.uid == uid;
        allow delete: if isSelf(uid);
      }

      // ---------- Dados pessoais ----------
      match /users/{uid} {
        allow read, write: if isSelf(uid);

        // Pedidos de amizade e notificações podem ser criados por outros utilizadores.
        match /notifications/{nid} {
          allow read, update, delete: if isSelf(uid);
          allow create: if signedIn();
        }
        // Pedidos de amizade: quem envia escreve na caixa do destinatário com o seu próprio uid.
        match /requests/{fromUid} {
          allow read, delete: if isSelf(uid);
          allow create, update: if isSelf(fromUid);
        }
        match /friends/{fid} {
          allow read, update, delete: if isSelf(uid) || isSelf(fid);
          allow create: if isSelf(uid) || isSelf(fid);
        }
        match /{col}/{docId=**} {
          allow read, write: if isSelf(uid);
        }
      }

      // ---------- Grupos (households): família, amigos, casal, casa partilhada ----------
      // Cada pessoa pode estar em vários grupos. O antigo casal é um grupo como os outros.
      match /households/{hid} {
        allow read: if signedIn() && request.auth.uid in resource.data.members;

        // Quem cria fica como único membro e dono.
        allow create: if signedIn()
          && request.resource.data.members == [request.auth.uid]
          && request.resource.data.ownerUid == request.auth.uid;

        allow update: if
          // Membros editam nome, tipo, código e páginas partilhadas, sem mexer na lista de membros nem no dono.
          (isMember(hid)
            && request.resource.data.members == resource.data.members
            && request.resource.data.ownerUid == resource.data.ownerUid)
          // Sair do grupo (o dono que sai passa o grupo a quem fica).
          || (isMember(hid)
            && request.resource.data.members == resource.data.members.removeAll([request.auth.uid])
            && (request.resource.data.ownerUid == resource.data.ownerUid
              || (resource.data.ownerUid == request.auth.uid
                && request.resource.data.ownerUid in request.resource.data.members)))
          // O dono pode tirar outras pessoas do grupo.
          || (signedIn() && resource.data.ownerUid == request.auth.uid
            && request.auth.uid in request.resource.data.members
            && resource.data.members.hasAll(request.resource.data.members)
            && request.resource.data.ownerUid == resource.data.ownerUid)
          // Entrar com o código de convite (várias pessoas podem usar o mesmo código).
          || (signedIn()
            && !(request.auth.uid in resource.data.members)
            && resource.data.members.size() < 30
            && resource.data.inviteCode != null
            && request.resource.data.joinCode == resource.data.inviteCode
            && request.resource.data.members == resource.data.members.concat([request.auth.uid])
            && request.resource.data.ownerUid == resource.data.ownerUid);

        allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

        // Todas as subcoleções do grupo (tarefas, compras, finanças, ...).
        match /{col}/{docId=**} {
          allow read, write: if isMember(hid);
        }
      }

      // ---------- Páginas partilhadas (ex.: só a Lista de compras com alguém de fora do grupo) ----------
      function partilha(sid) {
        return get(/databases/$(database)/documents/artifacts/$(appId)/partilhas/$(sid)).data;
      }
      function inPartilha(sid) {
        return signedIn() && request.auth.uid in partilha(sid).membros_uids;
      }
      match /partilhas/{sid} {
        allow read: if signedIn() && request.auth.uid in resource.data.membros_uids;
        allow create: if signedIn()
          && request.resource.data.ownerUid == request.auth.uid
          && request.auth.uid in request.resource.data.membros_uids;
        allow update: if
          (inPartilha(sid)
            && request.resource.data.membros_uids == resource.data.membros_uids
            && request.resource.data.ownerUid == resource.data.ownerUid)
          || (inPartilha(sid)
            && request.resource.data.membros_uids == resource.data.membros_uids.removeAll([request.auth.uid])
            && request.resource.data.ownerUid == resource.data.ownerUid)
          || (signedIn()
            && !(request.auth.uid in resource.data.membros_uids)
            && resource.data.membros_uids.size() < 30
            && resource.data.inviteCode != null
            && request.resource.data.joinCode == resource.data.inviteCode
            && request.resource.data.membros_uids == resource.data.membros_uids.concat([request.auth.uid])
            && request.resource.data.ownerUid == resource.data.ownerUid);
        allow delete: if signedIn() && request.auth.uid == resource.data.ownerUid;

        match /{col}/{docId=**} {
          allow read, write: if inPartilha(sid);
        }
      }

      // Códigos de convite (de um grupo ou de uma página partilhada): quem conhece o código descobre-o.
      match /invites/{code} {
        allow get: if signedIn();
        allow list: if false;
        allow create: if signedIn() && (
          (request.resource.data.get('householdId', null) != null && isMember(request.resource.data.householdId))
          || (request.resource.data.get('partilhaId', null) != null && inPartilha(request.resource.data.partilhaId)));
        allow delete: if signedIn() && (
          (resource.data.get('householdId', null) != null && isMember(resource.data.householdId))
          || (resource.data.get('partilhaId', null) != null && inPartilha(resource.data.partilhaId)));
      }

      // Nome de utilizador -> email de recuperação. Lido antes do login (entrar com o
      // nome de utilizador depois de associar um email e pedir nova password).
      // Só se lê pela chave exata; cada conta só escreve a sua própria entrada.
      match /logins/{key} {
        allow get: if true;
        allow list: if false;
        allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
        allow update: if signedIn() && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
        allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      }

      // ---------- Viagens partilhadas (com amigos, não só o casal) ----------
      match /viagens_partilhadas/{tripId} {
        allow read: if signedIn() && request.auth.uid in resource.data.membros_uids;
        allow create: if signedIn() && request.auth.uid in request.resource.data.membros_uids;
        allow update, delete: if signedIn() && request.auth.uid in resource.data.membros_uids;

        match /{col}/{docId=**} {
          allow read, write: if signedIn()
            && request.auth.uid in get(/databases/$(database)/documents/artifacts/$(appId)/viagens_partilhadas/$(tripId)).data.membros_uids;
        }
      }
    }
  }
}
